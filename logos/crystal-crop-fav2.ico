					</div>
				</div>

				<div class="event_top">

					<div class="event_content" style="padding: 5px 5px 5px;">
						<img src="assets/frontassets/images/Ankur-Aggarwal-8jan24-th1.jpg">
						<div class="event_overlay">
							<a href="reward_recognition_event" style="margin: 0px; cursor: pointer;" contenteditable="false">event</a>
							<h4 class="crd">Ankur Aggarwal, our Managing Director, has been honoured with the prestigious title of CEO of the Year 2023 by Agriculture Today Group!</h4>
						</div>
					</div>

					<div class="event_content" style="padding: 5px 5px 5px;">
						<img src="assets/frontassets/images/event02-new.jpg">
						<div class="event_overlay">
							<a href="reward_recognition_event" style="margin: 0px; cursor: pointer;" contenteditable="false">event</a>
							<h4 class="crd">Reelection of Mr. N K Aggarwal as the Chairman of PHDCCI Membership Desk for 2023-24</h4>
