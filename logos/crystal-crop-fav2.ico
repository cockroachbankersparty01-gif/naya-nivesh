                    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

                    <script>
                        $(document).ready(function(){
                            $(".search-icon, .desktop_srch, #mobile_search_icon").click(function(){
                                $(".search_container").slideDown();
                                $("#searchString").focus();
                            });
                            $("#close_search").click(function(){
                                $(".search_container").slideUp();
                            });

                            $("#searchString").keyup(function(){
                                var searchString = $(this).val();
                                if(searchString.length > 1){
                                    $.ajax({
                                        url: "/SearchSuggestions",
                                        data: { term: searchString },
                                        success: function(data){
                                            var list = "";
                                            $.each(data, function(i, item){
                                                list += "<li><a href='"+item.url+"'>"+item.title+"</a></li>";
                                            });
                                            $("#searchResultList").html(list).show();
                                        }
                                    });
                                } else {
                                    $("#searchResultList").empty().hide();
                                }
                            });

                            $(document).click(function(e){
                                if (!$(e.target).closest('#searchResultList, #searchString').length && !$(e.target).closest('.search-icon, .desktop_srch, #mobile_search_icon').length){
                                    $("#searchResultList").hide();
                                }
                            });
                        });
                    </script>



