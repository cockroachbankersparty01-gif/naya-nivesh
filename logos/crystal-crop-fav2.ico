			<div class="event_detail aos-init" data-aos="fade-left" data-aos-duration="800">
				<div class="event_top">
					<div class="event_content" style="padding: 5px 5px 5px;">
						<h4 style="font-size: 16px; color: #1a2f80; line-height: 24px; font-weight: 500; margin: 15px 0 20px;">Ankur Aggarwal appointed as the Vice Chairman of CropLife India!</h4>
