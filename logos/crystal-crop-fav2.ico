    <style>
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
            background: #fff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            position: relative;
            z-index: 100;
        }

            .header img {
                max-height: 60px;
            }

        .navbar {
            display: flex;
            gap: 35px;
            align-items: center;
        }

            .navbar > li {
                list-style: none;
                position: relative;
            }

                .navbar > li > a {
                    text-decoration: none;
                    color: #000;
                    font-weight: 500;
                    padding: 8px 0;
                    display: inline-block;
                    position: relative;
                    text-transform: capitalize;
                }

                .navbar > li:hover > a {
                    color: #007bff;
                    border-bottom: 2px solid #007bff;
                }

            .navbar li ul {
                display: none;
                position: absolute;
                background: #fff;
                padding: 10px 0;
                min-width: 200px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                top: 100%;
                left: 0;
                z-index: 100;
            }

            .navbar li:hover > ul {
                display: block;
            }

            .navbar li ul li {
                position: relative;
            }

                .navbar li ul li a {
                    color: #000;
                    text-decoration: none;
                    padding: 8px 20px;
                    display: block;
                    text-transform: capitalize;
                }

                .navbar li ul li:hover > a {
                    background: #f5f5f5;
                }

                .navbar li ul li ul {
                    top: 0;
                    left: 100%;
                }

        .search-icon {
            cursor: pointer;
        }




        .search_container {
            display: none;
            position: fixed;
            background: rgba(0, 0, 0, 0.9);
            top: 0;
            width: 100%;
            height: 100%;
            left: 0;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: fixed;
        }

            .search_container img {
                max-height: 60px;
                margin-bottom: 20px;
            }

        .search_box {
            width: 80%;
            max-width: 600px;
        }

            .search_box input {
                width: 100%;
                padding: 15px;
                border: none;
                font-size: 18px;
            }

        #searchResultList {
            list-style: none;
            padding: 0;
            margin-top: 15px;
            color: #fff;
            text-align: left;
        }

        #close_search {
            position: absolute;
            top: 20px;
            right: 20px;
            color: white;
            font-size: 28px;
            cursor: pointer;
        }


        #navbar_menu ul li a {
            text-transform: capitalize;
        }

        .header_bottom .row {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
        }

        .search-icon {
            display: flex;
            justify-content: right;
            align-items: center;
            height: 100%; /* Important for vertical centering */
        }

        #navbar_menu > ul > li > a {
            font-weight: normal;
        }

        .home_page {
            border-left: 8px solid #50b848;
        }


        @media (max-width: 991px) {
         /*    .header_bottom .row

        {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: unset;
        } */

        .logo {
            display: flex;
            align-items: center;
            justify-content: flex-start;
        }

       /*  .menu_side {
            display: flex;
            align-items: center;
            justify-content: flex-end;
        } */

        .header_right {
            display: flex;
            align-items: center;
            margin-left: 10px;
                position: relative;
                
                top: -60px;
        }

            #navbar_menu.small-screen #menu-button {
                position: relative;
                right: 43px;
                float:right;
                margin-top: 20px;
                z-index: 9999;
                
            }

        }


    </style>



