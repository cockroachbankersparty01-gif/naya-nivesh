    <style>
        /* 1) Header & Menus: always on top */
        header.header_style_1,
        .header_bottom,
        .menu_side,
        #navbar_menu,
        #navbar_menu .first-ul,
        #navbar_menu .first-ul > li {
            position: relative;
            z-index: 1000000; /* super high, above sliders */
        }

            /* 2) All dropdown panels above everything */
            #navbar_menu .first-ul li ul,
            #navbar_menu .first-ul li ul li ul {
                position: absolute;
                z-index: 1000001; /* dropdown > header */
                overflow: visible;
            }

            /* 3) Kill any accidental clipping around menu */
            .header_bottom .container,
            .header_bottom .row,
            .menu_side,
            #navbar_menu {
                overflow: visible !important;
            }

        /* 4) Push Jssor sliders BELOW the header */
        .jssorl-009-spin,
        .jssorb132,
        .jssora051,
        .jssorb057 {
            position: relative !important;
            z-index: 1 !important; /* keep under the header/menu */
        }

        /* 5) Revolution/Jssor wrappers sometimes add stacking contexts */
        .rev_slider_wrapper,
        .rev_slider,
        .tp-revslider-mainul {
            z-index: 1 !important;
            overflow: visible !important;
        }

        /* 6) Fixed badges / social should not overtake header */
        .best_place,
        .social.foot {
            position: relative;
            z-index: 2 !important;
        }


        /* MOBILE ONLY: solid background for 2nd/3rd level menus */
        @media (max-width: 991px) {
            /* ensure each dropdown paints its own white panel */
            #navbar_menu .first-ul li ul

        {
            position: static !important;
            display: none; /* JS toggles */
            width: 100%;
            background: #fff !important; /* <-- solid * b-shq9dpml3o/
            border-top: 1px solid #eee;
            box-shadow: none !important;
            padding: 0;
            margin: 0;
            opacity: 1 !important;
            filter: none !important;
            backdrop-filter: none !important;
            mix-blend-mode: normal !important;
            isolation: isolate; /* own stacking context */
        }

        /* nested (sub-sub) menus */
        #navbar_menu .first-ul li ul li ul {
            position: static !important;
            display: none; /* JS toggles */
            background: #fff !important; /* <-- solid * b-shq9dpml3o/
            border-top: 1px solid #f2f2f2;
            padding-left: 14px;
            opacity: 1 !important;
            filter: none !important;
            backdrop-filter: none !important;
            mix-blend-mode: normal !important;
            isolation: isolate;
        }

        /* paint-bg trick in case parent had opacity anywhere */
        #navbar_menu .first-ul li > ul,
        #navbar_menu .first-ul li > ul > li > ul {
            position: relative;
        }

            #navbar_menu .first-ul li > ul::before,
            #navbar_menu .first-ul li > ul > li > ul::before {
                content: "";
                position: absolute;
                inset: 0;
                background: #fff; /* solid painter layer */
                z-index: 0;
            }

            #navbar_menu .first-ul li > ul * {
                position: relative;
                z-index: 1; /* sit above painter */
            }

        /* readable links */
        #navbar_menu .first-ul li ul li a {
            display: block;
            color: #111 !important;
            background: transparent !important;
            padding: 12px 14px;
            line-height: 1.35;
            white-space: normal;
        }

        /* open states (match your JS) */
        #navbar_menu li.open > ul {
            display: block;
        }

            #navbar_menu li.open > ul > li.open > ul {
                display: block;
            }

        }
    </style>
</head>
