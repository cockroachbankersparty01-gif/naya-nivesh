    <script>
      $(function() {
          
        // Handle the back/forward button
        window.onpopstate = function() {
            loadContent(window.location.pathname.split('/').pop());
        };          
          
        // Load footer and nav HTML
        $("#footerHtml").load("footer.html");
        $("#contentHtml").load("home.component.html");
        $(".read-to-talk-widget").load("ready-to-talk-widget.component.html");
        
        $("#navHtml").load("nav.html", function() {
          // Attach event delegation after nav is loaded
            $(document).on('click', '.nav-link, .dropdown-item', function(e) {
              e.preventDefault(); // Prevent default link behavior
              var page = $(this).data('url');

  // Change the URL without reloading the page
              history.pushState(null, '', page );            
              loadContent(page);
  //            $("#contentHtml").load(page + '.component.html');
            });          
        });
                
        function loadContent(page) {
            $("#contentHtml").load(page + '.component.html', function(response, status, xhr) {                
                // Set active class for the corresponding nav item
                $('.nav-link').removeClass('active'); // Remove active class from all nav items
                $('.nav-link[data-url="' + page + '"]').addClass('active'); // Add active class to the current item                
                if (status == "error") {
                    $("#contentHtml").html("<p>Error loading content: " + xhr.status + " " + xhr.statusText + "</p>");
                }
            });
        }
        
        // Initial Page Load
        var initialPage = window.location.pathname.split('/').pop() || 'home'; // Default page
        if (initialPage != '' && !initialPage.endsWith('.html')) {
            loadContent(initialPage);
        }        
        
      });
      
      
    </script>        
        

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
